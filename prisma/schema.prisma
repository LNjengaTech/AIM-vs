generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String         @unique
  emailVerified       DateTime?
  image               String?
  password            String?
  role                UserRole       @default(BUYER)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  accounts            Account[]
  buyerProfile        BuyerProfile?
  dealerProfile       DealerProfile?
  sessions            Session[]
  sentMessages        Message[]      @relation("SentMessages")
  receivedMessages    Message[]      @relation("ReceivedMessages")
  dealerConversations Conversation[] @relation("DealerConversations")
  adminConversations  Conversation[] @relation("AdminConversations")

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DealerProfile {
  id               String           @id @default(cuid())
  userId           String           @unique
  businessName     String
  businessPhone    String
  businessAddress  String
  location         String
  permitNumber     String?
  permitImageUrl   String?
  description      String?
  isVerified       Boolean          @default(false)
  isPioneer        Boolean          @default(false)
  verifiedAt       DateTime?
  pioneerBadgeDate DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cars             Car[]
  analytics        DealerAnalytics?
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isVerified])
  @@index([isPioneer])
}

model DealerAnalytics {
  id          String        @id @default(cuid())
  dealerId    String        @unique
  totalViews  Int           @default(0)
  totalLeads  Int           @default(0)
  totalSales  Int           @default(0)
  lastUpdated DateTime      @default(now())
  dealer      DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
}

model BuyerProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  phone        String?
  location     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  boloRequests BOLORequest[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagements  Engagement[]
  favorites    Favorite[]
  reviews      Review[]
  notifications Notification[]

  @@index([userId])
}

model Car {
  id                 String        @id @default(cuid())
  dealerId           String
  make               String
  model              String
  year               Int
  color              String
  bodyType           String
  transmission       String
  fuelType           String
  mileage            Int
  engineCapacity     String?
  price              Decimal       @db.Decimal(10, 2)
  negotiable         Boolean       @default(true)
  description        String?
  features           String[]
  condition          String
  status             CarStatus     @default(AVAILABLE)
  isFeatured         Boolean       @default(false)
  images             String[]
  has360View         Boolean       @default(false)
  completenessScore  Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  soldAt             DateTime?
  aiVerified         Boolean       @default(false)
  aiVerificationData Json?
  slug               String        @unique
  isVerified         Boolean       @default(false)
  boloMatches        BOLOMatch[]
  dealer             DealerProfile @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  engagements        Engagement[]
  favorites          Favorite[]

  @@index([dealerId])
  @@index([make])
  @@index([model])
  @@index([year])
  @@index([price])
  @@index([status])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([slug])
}

model BOLORequest {
  id               String       @id @default(cuid())
  buyerId          String
  make             String?
  model            String?
  yearMin          Int?
  yearMax          Int?
  priceMin         Decimal?     @db.Decimal(10, 2)
  priceMax         Decimal?     @db.Decimal(10, 2)
  color            String?
  bodyType         String?
  transmission     String?
  fuelType         String?
  description      String?
  maxMileage       Int?
  isActive         Boolean      @default(true)
  notificationSent Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  matches          BOLOMatch[]
  buyer            BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([isActive])
  @@index([make])
  @@index([model])
}

model BOLOMatch {
  id            String      @id @default(cuid())
  boloRequestId String
  carId         String
  matchScore    Int
  notified      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  boloRequest   BOLORequest @relation(fields: [boloRequestId], references: [id], onDelete: Cascade)
  car           Car         @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([boloRequestId, carId])
  @@index([boloRequestId])
  @@index([carId])
}

model Favorite {
  id        String       @id @default(cuid())
  buyerId   String
  carId     String
  createdAt DateTime     @default(now())
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  car       Car          @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@unique([buyerId, carId])
  @@index([buyerId])
  @@index([carId])
}

model Engagement {
  id        String         @id @default(cuid())
  buyerId   String
  carId     String
  type      EngagementType
  metadata  Json?
  createdAt DateTime       @default(now())
  buyer     BuyerProfile   @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  car       Car            @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([carId])
  @@index([type])
  @@index([createdAt])
}

model HeroSection {
  id                   String   @id @default(cuid())
  isActive             Boolean  @default(true)
  headline             String?  @default("Find Your Perfect Car – Verified, Available, and Matched Just for You!")
  subheadline          String?  @default("No more wasted trips. Browse live inventory, set alerts, and connect with trusted dealers.")
  hasFeaturedCar       Boolean  @default(false)
  featuredCarId        String?
  backgroundImageUrl   String?
  selectedColor        String?
  updatedAt            DateTime @updatedAt
  foregroundImageScale Float?   @default(1)
  foregroundImageUrl   String?
  foregroundImageX     Float?   @default(0)
  foregroundImageY     Float?   @default(0)
  specs                Json?
  tagline              String?

  @@index([isActive])
}

model Review {
  id          String       @id @default(cuid())
  buyerId     String
  content     String
  rating      Int?
  isPublished Boolean      @default(false)
  isRemoved   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  buyer       BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([isPublished])
  @@index([createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  title      String
  message    String
  link       String?
  isRead     Boolean          @default(false)
  createdAt  DateTime         @default(now())
  targetRole UserRole?
  buyerId    String?
  buyer      BuyerProfile?    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@index([isRead])
  @@index([createdAt])
  @@index([buyerId])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([isRead])
}

model Conversation {
  id        String   @id @default(cuid())
  dealerId  String   @unique
  adminId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dealer    User     @relation("DealerConversations", fields: [dealerId], references: [id], onDelete: Cascade)
  admin     User     @relation("AdminConversations", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([adminId])
}


enum UserRole {
  BUYER
  DEALER
  ADMIN
}

enum CarStatus {
  AVAILABLE
  SOLD
  RESERVED
}

enum EngagementType {
  VIEW
  FAVORITE
  SPIN_360
  COLOR_CHANGE
  CONTACT_DEALER
  SHARE
}

enum NotificationType {
  NEW_DEALER
  NEW_REVIEW
  DEALER_VERIFIED
  BOLO_MATCH
  NEW_CAR_LISTING
}
